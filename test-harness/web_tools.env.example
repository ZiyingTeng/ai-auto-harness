# WebSearch backend keys (pick one and set a real key)
# TAVILY_API_KEY=tvly-xxxx
# BRAVE_SEARCH_API_KEY=xxxx
# SERPAPI_API_KEY=xxxx

# Upstream model/proxy settings for anthropic-qwen-proxy
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=sk-xxxx
# ANTHROPIC_PROXY_MODEL=deepseek-v4-pro
# ANTHROPIC_PROXY_PORT=8082
# ANTHROPIC_PROXY_MAX_OUTPUT_TOKENS=8192

# Optional network proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=127.0.0.1,localhost,::1

# WebFetch safety knobs
# Keep preflight ON for normal testing
# CLAUDE_CODE_SKIP_WEBFETCH_PREFLIGHT=0

# Rate limit knobs (for custom search gateway scripts)
# SEARCH_QPS=2
# SEARCH_RETRY_MAX=3
# SEARCH_TIMEOUT_MS=15000
